{
  "name": "yun-zhi-xiang-zhi",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "npm run build:cloudfunctions && uni build -p mp-weixin && node copy-cloud-functions.js",
    "build:mp-weixin:test": "npm run build:cloudfunctions && uni build -p mp-weixin --mode test && node copy-cloud-functions.js",
    "build:mp-weixin:prod": "npm run build:cloudfunctions && uni build -p mp-weixin --mode production && node copy-cloud-functions.js",
    "test": "node scripts/test-local.mjs run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:integration": "vitest run tests/integration",
    "test:performance": "vitest run tests/performance",
    "test:coverage": "node scripts/test-local.mjs run --coverage",
    "test:e2e": "npm run build:mp-weixin:test && jest tests/e2e",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --no-fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "dependencies:check": "node scripts/check-dependency-locks.mjs",
    "acceptance:generate": "node scripts/generate-acceptance.mjs",
    "acceptance:check": "node scripts/generate-acceptance.mjs --check",
    "jobs:dry-run": "node scripts/run-business-jobs.mjs",
    "deploy:test": "node scripts/deploy-test.mjs",
    "build:cloudfunctions": "npm run contracts:check && npm run typecheck:server && node scripts/build-cloudfunctions.mjs",
    "check:repo": "node scripts/check-repository.cjs",
    "format": "prettier --write .",
    "postinstall": "node scripts/repair-vendor-types.mjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-3080220230511001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-3080220230511001",
    "@dcloudio/uni-components": "3.0.0-alpha-3080220230511001",
    "@dcloudio/uni-h5": "3.0.0-alpha-3080220230511001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-3080220230511001",
    "@noble/hashes": "1.8.0",
    "ajv": "8.18.0",
    "dayjs": "1.11.18",
    "exceljs": "4.4.0",
    "pinia": "2.0.36",
    "vue": "3.5.44",
    "vue-i18n": "11.4.18",
    "wot-design-uni": "^1.2.24",
    "wx-server-sdk": "4.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.3",
    "@commitlint/config-conventional": "^17.6.3",
    "@dcloudio/types": "^3.3.3",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-3080220230511001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-3080220230511001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-3080220230511001",
    "@rushstack/eslint-patch": "^1.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "22.19.0",
    "@types/wechat-miniprogram": "^3.4.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.4.0",
    "dotenv": "^17.3.1",
    "esbuild": "0.25.11",
    "eslint": "^8.41.0",
    "eslint-plugin-vue": "^9.14.1",
    "husky": "^8.0.3",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "jsdom": "^28.1.0",
    "json-schema-to-typescript": "15.0.4",
    "lint-staged": "^13.2.2",
    "miniprogram-automator": "^0.12.1",
    "prettier": "^2.8.8",
    "sass": "^1.62.1",
    "typescript": "^5.0.4",
    "vite": "^4.3.9",
    "vitest": "4.1.12",
    "vue-tsc": "3.1.1"
  },
  "overrides": {
    "mkdirp@0.5.1": "0.5.6",
    "form-data@^2.3.2": "2.5.6",
    "proxy-addr@^2.0.0": "2.0.8",
    "exceljs@4.4.0": {
      "uuid": "11.1.1"
    },
    "yaml@>=2.0.0 <2.8.3": "2.8.3",
    "axios": "0.34.0",
    "jpeg-js": "0.4.4",
    "qs": "6.17.1",
    "micromatch": "4.0.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
