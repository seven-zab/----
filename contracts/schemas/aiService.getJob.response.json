{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "partial_success",
        "failed"
      ]
    },
    "message_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "intent_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "proposal_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "action": {
              "type": "string",
              "enum": [
                "submit_my_demand",
                "claim_my_demand",
                "add_my_progress",
                "submit_my_completion"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "collecting",
                "ready",
                "executed",
                "cancelled",
                "expired",
                "failed"
              ]
            },
            "demand_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "demand_status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "draft",
                    "pending_audit",
                    "rejected",
                    "pending_claim",
                    "claiming",
                    "processing",
                    "pending_review",
                    "completed",
                    "cancelled",
                    "expired",
                    "terminated"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "detail_path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                {
                  "type": "null"
                }
              ]
            },
            "error_code": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "intent_id",
            "version",
            "proposal_id",
            "action",
            "status",
            "demand_id",
            "demand_status",
            "detail_path",
            "error_code"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "quota": {
      "type": "object",
      "properties": {
        "quota_kind": {
          "const": "general_chat"
        },
        "quota_day": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10
        },
        "limit": {
          "const": 10
        },
        "used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reset_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "quota_kind",
        "quota_day",
        "limit",
        "used",
        "reserved",
        "remaining",
        "reset_at"
      ],
      "additionalProperties": false
    },
    "retry_after_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "message_id",
    "operation_result",
    "quota",
    "retry_after_ms",
    "error_code"
  ],
  "additionalProperties": false
}
