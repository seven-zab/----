{
  "type": "object",
  "properties": {
    "application": {
      "type": "object",
      "properties": {
        "application_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requested_role": {
          "type": "string",
          "enum": [
            "general_user",
            "farmer",
            "teacher_student",
            "local_admin",
            "super_admin"
          ]
        },
        "profile_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "farmer",
                "merchant",
                "teacher",
                "student"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_region_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "review_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "withdrawn"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "application_id",
        "requested_role",
        "profile_kind",
        "scope_region_id",
        "organization_id",
        "review_scope",
        "status",
        "version",
        "created_at",
        "reason"
      ],
      "additionalProperties": false
    },
    "material_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 5,
      "minItems": 0,
      "uniqueItems": true
    },
    "details": {
      "type": "object",
      "properties": {
        "contact_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "contact_phone": {
          "type": "string",
          "pattern": "^1[3-9][0-9]{9}$"
        },
        "school_identity_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "business_description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "proof_kind": {
          "type": "string",
          "enum": [
            "land_proof",
            "business_license",
            "operation_photo"
          ]
        }
      },
      "required": [
        "contact_name",
        "contact_phone"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "application",
    "material_ids",
    "details"
  ],
  "additionalProperties": false
}
