{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "user_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "display_name": {
      "type": "string",
      "minLength": 0,
      "maxLength": 80
    },
    "avatar_file_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "banned",
        "deactivated"
      ]
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "role": {
            "type": "string",
            "enum": [
              "general_user",
              "farmer",
              "teacher_student",
              "local_admin",
              "super_admin"
            ]
          },
          "profile_kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "farmer",
                  "merchant",
                  "teacher",
                  "student"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "organization_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "scope_type": {
            "type": "string",
            "enum": [
              "self",
              "region",
              "platform"
            ]
          },
          "scope_region_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revoked",
              "expired"
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "renewed_from": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "grant_id",
          "role",
          "profile_kind",
          "organization_id",
          "scope_type",
          "scope_region_id",
          "status",
          "expires_at",
          "renewed_from"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 0,
      "uniqueItems": true
    },
    "auth_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "application_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "application_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "requested_role": {
            "type": "string",
            "enum": [
              "general_user",
              "farmer",
              "teacher_student",
              "local_admin",
              "super_admin"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "withdrawn"
            ]
          }
        },
        "required": [
          "application_id",
          "requested_role",
          "status"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "user_id",
    "user_code",
    "display_name",
    "avatar_file_id",
    "account_status",
    "grants",
    "auth_version",
    "application_summaries"
  ],
  "additionalProperties": false
}
