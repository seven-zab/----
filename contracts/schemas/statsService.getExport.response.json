{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "ready",
        "failed"
      ]
    },
    "file_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "report_layout": {
      "const": "zh_summary"
    },
    "regenerate": {
      "type": "object",
      "properties": {
        "report": {
          "type": "string",
          "enum": [
            "overview",
            "trend",
            "category"
          ]
        },
        "query": {
          "type": "object",
          "properties": {
            "business_scene": {
              "type": "string",
              "enum": [
                "village",
                "campus"
              ]
            },
            "campus_organization_id": {
              "const": "sztu"
            },
            "scope_region_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "start_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "type": {
              "type": "string",
              "enum": [
                "enterprise",
                "agriculture",
                "research",
                "campus"
              ]
            }
          },
          "required": [
            "start_at",
            "end_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "report",
        "query"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": false
}
